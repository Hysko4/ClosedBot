{
  "name": "closedbot",
  "version": "0.9.12",
  "private": true,
  "description": "Equipo personal de agentes de IA (Claude y Codex) con interfaz web instalable en el teléfono.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p .",
    "start": "node --disable-warning=ExperimentalWarning dist/src/server.js",
    "password": "node --disable-warning=ExperimentalWarning dist/src/cli/password.js",
    "access": "node --disable-warning=ExperimentalWarning dist/src/cli/access.js",
    "test": "tsc -p . && node --disable-warning=ExperimentalWarning --test --test-concurrency=1 dist/test/*.test.js",
    "check": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.316",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "sherpa-onnx-node": "1.13.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^6.0.2"
  }
}
