# Plantilla de /etc/cuadrilla.env (dueño root, permisos 600). Ver README para todas las opciones.

# Clave de API de Anthropic para los agentes de Claude.
ANTHROPIC_API_KEY=

# Solo localhost: el teléfono entra por `tailscale serve --bg 8787`.
CUADRILLA_HOST=127.0.0.1
CUADRILLA_PORT=8787

# CUADRILLA_DATA_DIR=/home/cuadrilla/.cuadrilla
# CUADRILLA_MAX_HOPS=6
# CUADRILLA_PLAYWRIGHT=0
# CUADRILLA_SESSION_DAYS=30
