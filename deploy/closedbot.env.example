# Plantilla de /etc/closedbot.env (dueño root, permisos 600). Ver README para todas las opciones.
# (Las variables CUADRILLA_* de antes del cambio de nombre siguen funcionando.)

# Claude: lo normal es iniciar sesión con tu cuenta desde Ajustes. Si prefieres una clave de API
# de Anthropic, ponla aquí (manda sobre la sesión).
# ANTHROPIC_API_KEY=

# Solo localhost: el teléfono entra por `tailscale serve --bg 8787`.
CLOSEDBOT_HOST=127.0.0.1
CLOSEDBOT_PORT=8787

# CLOSEDBOT_DATA_DIR=/home/closedbot/.closedbot
# CLOSEDBOT_MAX_HOPS=6
# CLOSEDBOT_PLAYWRIGHT=0
# CLOSEDBOT_SESSION_DAYS=30
